{
  "name": "pi-muse-code",
  "version": "1.0.0",
  "description": "Pi extension registering the muse-code provider through the Muse SDK over MSP against a persistent muse serve host, resuming one muse session per Pi conversation",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi", "pi-extension", "muse-code", "msp"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zereight/pi-muse-code.git"
  },
  "files": ["src", "agents", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@muse-code/sdk": "1.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  }
}
